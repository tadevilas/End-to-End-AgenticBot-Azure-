# ==============================================================================
# Azure AI Foundry & Databricks MCP Architecture — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. General Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:8501", "http://localhost:3000"]

# ------------------------------------------------------------------------------
# 2. Azure AI Foundry — Chat Model (Serverless API / MaaS)
# ------------------------------------------------------------------------------
# Models: Phi-3.5-mini-instruct, Phi-4, Meta-Llama-3.1-8B-Instruct
AZURE_AI_FOUNDRY_CHAT_ENDPOINT=https://ai-chatbot-2112.services.ai.azure.com/models
AZURE_AI_FOUNDRY_CHAT_KEY=your_foundry_chat_api_key_here
AZURE_AI_FOUNDRY_CHAT_MODEL_NAME=Llama-3.3-70B-Instruct
AZURE_AI_FOUNDRY_PLANNER_MODEL_NAME=Llama-3.3-70B-Instruct

# ------------------------------------------------------------------------------
# 3. Embeddings (local, free) - fastembed runs inside the app, nothing to deploy
# ------------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# ------------------------------------------------------------------------------
# 4. Search Service (Azure AI Search Free / Basic Tier)
# ------------------------------------------------------------------------------
AZURE_SEARCH_ENDPOINT=https://search-rag-2112.search.windows.net
AZURE_SEARCH_INDEX_NAME=kb-foundry-documents
AZURE_SEARCH_API_KEY=your_search_api_key_here

# ------------------------------------------------------------------------------
# 5. Azure Cosmos DB (Free Tier: 1,000 RU/s + 25GB Storage Free Forever)
# ------------------------------------------------------------------------------
AZURE_COSMOS_ENDPOINT=https://cosmos-rag-freetier.documents.azure.com:443/
AZURE_COSMOS_DATABASE_NAME=enterprise_rag_db
AZURE_COSMOS_CONTAINER_NAME=conversations
AZURE_COSMOS_KEY=your_cosmos_key_here

# ------------------------------------------------------------------------------
# 6. Azure Key Vault
# ------------------------------------------------------------------------------
AZURE_KEYVAULT_URL=https://kv-rag-2112.vault.azure.net/

# ------------------------------------------------------------------------------
# 7. MCP Tools (Databricks SQL & Tavily Search)
# ------------------------------------------------------------------------------
# Databricks SQL Warehouse Connection for SQL MCP Tool
DATABRICKS_SERVER_HOSTNAME=adb-1234567890.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/a1b2c3d4e5f6
DATABRICKS_TOKEN=dapi_your_databricks_personal_access_token_here

# Tavily Web Search MCP Tool
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# ------------------------------------------------------------------------------
# 8. Streamlit Frontend Configuration
# ------------------------------------------------------------------------------
BACKEND_API_URL=http://localhost:8000
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# ------------------------------------------------------------------------------
# Azure Blob Storage (source documents; uses Azure AD login, no key needed)
# ------------------------------------------------------------------------------
AZURE_STORAGE_ACCOUNT_NAME=stragchatbot2112
AZURE_STORAGE_CONTAINER_NAME=documents
